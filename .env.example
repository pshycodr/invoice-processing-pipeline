# Copy to .env and edit: cp .env.example .env
# Every value below is the default. Delete a line to keep the default.
# Quote values that contain spaces, for example SHEET_NAME="My Bills".

# -- Huggingface ---
HF_TOKEN= 

# --- Models (Ollama) ---
# Language model that turns OCR text into JSON. Any model from `ollama list` works.
TEXT_MODEL=gemma3:1b
# Vision model used when OCR fails, the bill is handwritten, or no items were found.
VISION_MODEL=qwen3-vl:4b-instruct
# Model name used by the GLM-OCR engine.
GLM_OCR_MODEL=glm-ocr
# Where Ollama is running.
OLLAMA_HOST=http://localhost:11434
# Seconds to wait for Ollama before a call counts as failed.
OLLAMA_TIMEOUT=300
# Context window size sent to the model.
NUM_CTX=8192
# Maximum tokens the model may generate. Stops a small model from looping.
MAX_OUTPUT_TOKENS=3072

# --- OCR ---
# Default OCR engine: glm (more accurate) or rapid (faster on CPU).
OCR_ENGINE=glm
# Longest image side in pixels before OCR.
OCR_MAX_SIDE=1800
# Longest image side in pixels sent to the vision model.
VISION_MAX_SIDE=1344
# Photo enhancement before OCR. 1.0 means no change.
OCR_CONTRAST=1.5
OCR_SHARPNESS=1.7
# OCR below this average confidence (0 to 1) counts as failed.
OCR_MIN_CONF=0.50
# OCR with fewer characters than this counts as failed.
MIN_OCR_CHARS=30
# OCR with fewer readable words than this counts as failed.
MIN_OCR_WORDS=4
# OCR where fewer than this share of tokens are readable words counts as failed.
MIN_WORD_RATIO=0.15

# --- Extraction ---
# 1 = rules correct the total, date and store. 0 = use the raw model output.
USE_RULES=1

# --- Output ---
# Where approved bills go: csv or sheet.
SYNC_TARGET=csv
# Google Sheet name, with "Bills" and "Items" tabs. Only used when SYNC_TARGET=sheet.
SHEET_NAME=Bills
# Path to the Google service account key. Only used when SYNC_TARGET=sheet.
GOOGLE_CREDS=creds.json

# --- Storage ---
# Folder for uploads, the database, categories and CSV files.
DATA_DIR=./data
